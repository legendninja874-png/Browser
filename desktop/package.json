{
  "name": "eon-browser-desktop",
  "version": "1.0.0",
  "description": "EoN Browser — Desktop App (Electron)",
  "main": "electron-main.js",
  "author": "EoN Browser",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
